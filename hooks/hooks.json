{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-delegation.py", "timeout": 10,
            "statusMessage": "Checking the delegation contract..." }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-frozen-tests.sh", "timeout": 10,
            "statusMessage": "Checking the test freeze..." },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-files.sh", "timeout": 10,
            "statusMessage": "Checking file protections..." },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/warn-large-files.sh", "timeout": 10,
            "statusMessage": "Checking for build artifacts..." },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scan-secrets.sh", "timeout": 10,
            "statusMessage": "Scanning for secrets..." }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard-frozen-tests-bash.py", "timeout": 10,
            "statusMessage": "Checking the test freeze (shell)..." },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-dangerous-commands.sh", "timeout": 10,
            "statusMessage": "Checking command safety..." },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator-only-git.sh", "timeout": 10,
            "statusMessage": "Checking git ownership..." }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh", "timeout": 10,
            "statusMessage": "Loading project context..." }
        ]
      }
    ]
  }
}
